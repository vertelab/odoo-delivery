<odoo>
    <record id="view_product_form_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.view_product_form"/>
        <field name="arch" type="xml">
            <!-- Add the new field and the button to the product form, for example, in the general information tab -->
            <xpath expr="//sheet/notebook/page[@string='General Information']/group" position="inside">
                <field name="ongoing_article_number"/>
            </xpath>
            <!-- Add the button to the form view's header -->
            <xpath expr="//header" position="inside">
                <button name="sync_product_to_ongoing" type="object" string="Sync to Ongoing" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
