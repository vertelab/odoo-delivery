<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="payment_delivery" name="Delivery Carrier Data" inherit_id="website_sale.payment_delivery">
            <xpath expr="//li" position="inside">
                <t t-if="delivery.pickup_location">
                    <span><t t-out="delivery.carrier_data"/></span>
                </t>
            </xpath>
        </template>

        <record id="view_delivery_carrier_form" model="ir.ui.view">
            <field name="name">delivery.carrier</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="arch" type="xml">
                <field name="carrier_description" position="after">
                    <label for="carrier_data"/>
                    <field name="carrier_data"/>
                </field>
            </field>
        </record>

