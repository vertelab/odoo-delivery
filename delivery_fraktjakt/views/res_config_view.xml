<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.delivery_fraktjakt</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="30" />
            <field name="inherit_id" ref="stock.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <block name="operations_setting_container" position="after">
                    <block title="Fraktjakt" name="fraktjakt_setting_container">
                        <div class="row mt16 o_settings_container" name="fraktjakt_setting_container">
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_environment" title="Activate Fraktjakt for production">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_environment" />
                                    <a href="https://www.fraktjakt.se/webshops/change?locale=en#Integrations" title="Documentation" class="o_doc_link" target="_blank" />
                                    <div class="text-muted">Your fraktjakt mode</div>
                                    <field name="fraktjakt_environment" required="1" default="test" />
                                </div>
                            </div>
                            <!-- Consignor Id -->
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_pid" invisible="fraktjakt_environment in ['test',False]">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_pid" />
                                    <div class="text-muted">Fraktjakt id for production</div>
                                    <field name="fraktjakt_pid" invisible="fraktjakt_environment in ['test',False]" />
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_tid" invisible="fraktjakt_environment == 'production'">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_tid" />
                                    <div class="text-muted">Fraktjakt id for test</div>
                                    <field name="fraktjakt_tid" invisible="fraktjakt_environment == 'production'" />
                                </div>
                            </div>
                            <!-- Key -->
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_pkey" invisible="fraktjakt_environment in ['test',False]">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_pkey" />
                                    <div class="text-muted">Fraktjakt key for production</div>
                                    <field name="fraktjakt_pkey" invisible="fraktjakt_environment in ['test',False]" />
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_tkey" invisible="fraktjakt_environment == 'production'">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_tkey" />
                                    <div class="text-muted">Fraktjakt key for test</div>
                                    <field name="fraktjakt_tkey" invisible="fraktjakt_environment == 'production'" />
                                </div>
                            </div>
                            <!-- URL -->
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_purl" invisible="fraktjakt_environment in ['test',False]">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_purl" />
                                    <div class="text-muted">Fraktjakt url for production</div>
                                    <field name="fraktjakt_purl" invisible="fraktjakt_environment in ['test',False]" />
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="fraktjakt_turl" invisible="fraktjakt_environment == 'production'">
                                <div class="o_setting_left_pane" />
                                <div class="o_setting_right_pane">
                                    <label for="fraktjakt_turl" />
                                    <div class="text-muted">Fraktjakt url for test</div>
                                    <field name="fraktjakt_turl" invisible="fraktjakt_environment == 'production'" />
                                </div>
                            </div>
                        </div>
                    </block>
                </block>
            </field>
        </record>
    </data>
</odoo>
