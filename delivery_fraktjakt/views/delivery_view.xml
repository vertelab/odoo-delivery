<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Delivery Carriers -->
        <record id="view_delivery_carrier_form" model="ir.ui.view">
            <field name="name">delivery.carrier.form</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="is_fraktjakt" />
                </field>
            </field>
        </record>

        <record id="choose_delivery_package_view_form" model="ir.ui.view">
            <field name="name">choose.delivery.package.form</field>
            <field name="model">choose.delivery.package</field>
            <field name="inherit_id" ref="delivery.choose_delivery_package_view_form" />
            <field name="arch" type="xml">
                <field name="delivery_package_type_id" position="after">
                    <field name="fraktjakt_package_type" invisible="1"/>
                    <field name="height" attrs="{'invisible': [('fraktjakt_package_type', '==', 'others')]}"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
