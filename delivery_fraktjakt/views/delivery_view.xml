<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Delivery Carriers -->
        <record id="view_delivery_carrier_form" model="ir.ui.view">
            <field name="name">delivery.carrier.form</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
            <field name="arch" type="xml">
                <field name="product_id" position="after">
                    <field name="is_fraktjakt" />
                </field>
            </field>
        </record>

        <record id="choose_delivery_package_view_form" model="ir.ui.view">
            <field name="name">choose.delivery.package.form</field>
            <field name="model">choose.delivery.package</field>
            <field name="inherit_id" ref="delivery.choose_delivery_package_view_form" />
            <field name="arch" type="xml">
                <field name="delivery_package_type_id" position="after">
                    <field name="fraktjakt_package_type" invisible="1"/>
                    <field name="height" attrs="{'invisible': [('fraktjakt_package_type', '==', 'others')]}"/>
                    <field name="weight_deficit" invisible="1"/>
                </field>

                <xpath expr="//form/group[1]" position="before">
                    <div class="alert alert-warning mb-3" role="alert" attrs="{'invisible': [('weight_deficit', '=', False)]}">
                        <i class="fa fa-warning" title="warning"/>
                        <strong>Warning:</strong> Some products are missing weight information:
                        <span class="font-weight-bold text-danger"><field name="weight_deficit_products" nolabel="1" readonly="1"/></span>
                    </div>
                    
                    
                    <div class="alert alert-warning mb-3" role="alert" attrs="{'invisible': [('no_done_products', '=', False)]}">
                        <i class="fa fa-warning" title="warning"/>
                        <strong>Warning:</strong> Nothing is set to done and the weight is now only the package weight. Please set some to done or manually add a total weight for the package and the products within it.
                    </div>
                    
                </xpath>

            </field>
        </record>

    </data>
</odoo>
